---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { AUTHOR } from '../../../site.config.mjs';
import { getThoughts, formatDate, type Lang } from '../../data/thoughts';

export async function getStaticPaths() {
  const thoughts = await getThoughts();
  return thoughts.map((t) => ({ params: { slug: t.slug }, props: { thought: t } }));
}

const { thought } = Astro.props;
const langs: Lang[] = ['en', 'zh'];

// When a post exists in only one language, show it under both toggles with a short note.
const rendered = await Promise.all(
  langs.map(async (lang) => {
    const entry = thought.versions[lang] ?? thought.versions[lang === 'en' ? 'zh' : 'en']!;
    const { Content } = await render(entry);
    return { lang, entry, Content, fallback: !thought.versions[lang] };
  }),
);
const title = (thought.versions.en ?? thought.versions.zh!).data.title;
---

<Base title={`${title} — ${AUTHOR.en}`}>
  <article>
    <a href="/#thoughts" class="mono back"><span lang="en">← Thoughts</span><span lang="zh">← 想法</span></a>
    {
      rendered.map(({ lang, entry, Content, fallback }) => (
        <div lang={lang}>
          <div class="mono">{formatDate(thought.date, lang)}</div>
          <h1>{entry.data.title}</h1>
          {fallback && (
            <p class="mono note">
              {lang === 'en' ? 'This post is only available in Chinese.' : '这篇文章目前只有英文版。'}
            </p>
          )}
          <div class="body">
            <Content />
          </div>
        </div>
      ))
    }
  </article>
</Base>

<style>
  article {
    max-width: 640px;
    padding-bottom: 48px;
  }

  .back {
    display: inline-block;
    margin-bottom: 28px;
    text-decoration: none;
  }

  h1 {
    font-family: var(--head);
    font-weight: 400;
    font-size: 42px;
    line-height: 1.15;
    margin: 8px 0 24px;
  }

  :global(html[data-lang='zh']) h1 {
    font-size: 32px;
    line-height: 1.4;
  }

  .note {
    margin-top: -12px;
  }

  .body {
    font-size: 17px;
    line-height: 1.75;
    color: var(--soft);
  }

  :global(html[data-lang='zh']) .body {
    font-size: 16px;
    line-height: 1.95;
  }

  .body :global(h2) {
    font-family: var(--head);
    font-weight: 400;
    font-size: 26px;
    color: var(--ink);
    margin: 36px 0 8px;
  }

  .body :global(pre) {
    font-family: var(--mono);
    font-size: 13px;
    padding: 14px 16px;
    border: 1px solid var(--rule);
    overflow-x: auto;
  }

  .body :global(code) {
    font-family: var(--mono);
    font-size: 0.88em;
  }

  .body :global(img) {
    max-width: 100%;
    height: auto;
  }

  .body :global(blockquote) {
    margin: 20px 0;
    padding-left: 16px;
    border-left: 1px solid var(--ink);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 32px;
    }
  }
</style>
