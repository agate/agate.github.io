---
import Base from '../layouts/Base.astro';
import { AUTHOR } from '../../site.config.mjs';
---

<Base title={`Not found — ${AUTHOR.en}`}>
  <section>
    <div class="mono">404</div>
    <h1><span lang="en">Nothing here yet.</span><span lang="zh">这里还什么都没有。</span></h1>
    <p><a href="/"><span lang="en">← Back home</span><span lang="zh">← 回首页</span></a></p>
  </section>
</Base>

<style>
  section {
    padding-bottom: 80px;
  }

  h1 {
    font-family: var(--head);
    font-weight: 400;
    font-size: 42px;
    margin: 8px 0 16px;
  }
</style>
