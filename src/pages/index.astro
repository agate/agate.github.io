---
import Base from '../layouts/Base.astro';
import { AUTHOR, GITHUB_URL } from '../../site.config.mjs';
import { projects } from '../data/projects';
import { getThoughts, formatDate } from '../data/thoughts';

const thoughts = await getThoughts();
const shipped = projects.filter((p) => p.status !== 'soon').length;
const building = projects.filter((p) => p.status === 'building').length;
---

<Base title={AUTHOR.en}>
  <section class="hero">
    <div class="mono">
      <span lang="en">Software engineer · Tinkerer</span><span lang="zh">软件工程师 · 爱捣鼓</span>
    </div>
    <h1 lang="en">I build small things,<br /><em>then keep building.</em></h1>
    <h1 lang="zh">做一些小东西，<br />然后接着做下去。</h1>
    <p class="lede" lang="en">
      I'm {AUTHOR.en}, a software engineer who likes making fun things — lights in a menu bar, a keyboard I configured
      myself, and now classical Chinese poems turned into pictures with AI.
    </p>
    <p class="lede" lang="zh">
      我是 {AUTHOR.zh}，一个软件工程师。喜欢捣鼓好玩的东西：菜单栏里的小灯、自己配的键盘，现在在用 AI 把古诗变成画。
    </p>
    <div class="stats mono">
      <span lang="en">{shipped} projects</span><span lang="zh">{shipped} 个作品</span>
      <span lang="en">{building} building now</span><span lang="zh">{building} 个在做</span>
      <span lang="en">{thoughts.length} thoughts</span><span lang="zh">{thoughts.length} 篇想法</span>
    </div>
  </section>

  <section class="sec" id="projects">
    <div class="mono num">01</div>
    <div>
      <h2><span lang="en">Projects</span><span lang="zh">作品</span></h2>
      <div class="grid">
        {
          projects.map((p) => {
            const Tag = p.url ? 'a' : 'div';
            return (
              <Tag class="cell" href={p.url}>
                <div class="icon" set:html={p.icon} />
                <div class="top">
                  <b>
                    <span lang="en">{p.name.en}</span>
                    <span lang="zh">{p.name.zh}</span>
                  </b>
                  <span class:list={['mono', 'tag', { live: p.status === 'building', dash: p.status === 'soon' }]}>
                    {p.status}
                  </span>
                </div>
                <p lang="en">{p.blurb.en}</p>
                <p lang="zh">{p.blurb.zh}</p>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="sec" id="thoughts">
    <div class="mono num">02</div>
    <div>
      <h2><span lang="en">Thoughts</span><span lang="zh">想法</span></h2>
      {
        thoughts.map((t) => {
          const en = t.versions.en ?? t.versions.zh!;
          const zh = t.versions.zh ?? t.versions.en!;
          return (
            <a class="post" href={`/thoughts/${t.slug}/`}>
              <span lang="en">{en.data.title}</span>
              <span lang="zh">{zh.data.title}</span>
              <span class="mono" lang="en">{formatDate(t.date, 'en')}</span>
              <span class="mono" lang="zh">{formatDate(t.date, 'zh')}</span>
            </a>
          );
        })
      }
    </div>
  </section>

  <section class="sec" id="about">
    <div class="mono num">03</div>
    <div>
      <h2><span lang="en">About</span><span lang="zh">关于</span></h2>
      <p lang="en">
        I write software for a living and for fun. This site is where the side projects and the ideas behind them live.
        Find my code on <a href={GITHUB_URL}>GitHub</a>.
      </p>
      <p lang="zh">
        写代码是我的工作，也是我的爱好。这里放我的业余作品，和它们背后的想法。代码都在
        <a href={GITHUB_URL}>GitHub</a> 上。
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    margin-bottom: 44px;
  }

  h1 {
    font-family: var(--head);
    font-weight: 400;
    font-size: 52px;
    line-height: 1.1;
    margin: 10px 0 16px;
  }

  :global(html[data-lang='zh']) h1 {
    font-size: 38px;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  h1 em {
    font-style: italic;
  }

  .lede {
    font-size: 18px;
    color: var(--soft);
    max-width: 580px;
    line-height: 1.65;
    margin: 0;
  }

  :global(html[data-lang='zh']) .lede {
    font-size: 16px;
    line-height: 1.9;
  }

  .stats {
    display: flex;
    gap: 28px;
    margin-top: 22px;
  }

  .sec {
    display: grid;
    grid-template-columns: 48px 1fr;
    border-top: 1px solid var(--rule);
    padding: 28px 0 36px;
    scroll-margin-top: 16px;
  }

  .num {
    padding-top: 10px;
  }

  h2 {
    font-family: var(--head);
    font-weight: 400;
    font-size: 30px;
    margin: 0 0 14px;
  }

  :global(html[data-lang='zh']) h2 {
    font-size: 24px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-left: 1px solid var(--rule);
    border-top: 1px solid var(--rule);
  }

  .cell {
    display: block;
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 18px 18px 22px;
    text-decoration: none;
    transition: background 0.15s;
  }

  a.cell:hover {
    background: #fff;
  }

  .icon :global(svg) {
    display: block;
    margin: 0 auto 12px;
    max-width: 100%;
    height: auto;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .top b {
    font-family: var(--head);
    font-weight: 400;
    font-size: 22px;
  }

  :global(html[data-lang='zh']) .top b {
    font-size: 19px;
    font-weight: 600;
  }

  .cell p {
    margin: 6px 0 0;
    color: #4a4a4a;
    font-size: 15px;
  }

  .post {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px dotted var(--faint);
    font-size: 17px;
    text-decoration: none;
  }

  .post:hover span:not(.mono) {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post .mono {
    padding-top: 4px;
    flex-shrink: 0;
  }

  #about p {
    margin: 0;
    max-width: 580px;
    color: var(--soft);
  }

  @media (max-width: 640px) {
    h1 {
      font-size: 38px;
    }

    :global(html[data-lang='zh']) h1 {
      font-size: 30px;
    }

    .stats {
      gap: 16px;
      flex-wrap: wrap;
    }

    .sec {
      grid-template-columns: 1fr;
    }

    .num {
      padding-top: 0;
      margin-bottom: 4px;
    }

    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
